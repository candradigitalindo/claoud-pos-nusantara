# Server
PORT=3000

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cloud_pos
DB_SSLMODE=disable

# JWT
JWT_SECRET=your-cloud-jwt-secret-change-in-production

# Webhook
WEBHOOK_SECRET=shared-secret-between-cloud-and-pos

# Token admin statis (opsional): pembawanya diperlakukan sebagai superadmin.
# Kosongkan = nonaktif (disarankan; akses admin lewat login). Bila diisi, nilai
# kosong, kurang dari 32 karakter, atau nilai contoh/bawaan ditolak aplikasi.
# Buat nilai acak dengan:
#   openssl rand -hex 32
ADMIN_TOKEN=

# CCTV: alamat API go2rtc internal untuk pengembangan di luar Compose.
GO2RTC_URL=http://go2rtc:1984
# Opsional; kosong memakai turunan JWT_SECRET. Pertahankan kunci ini setelah
# kamera disimpan. Jangan menggantinya tanpa migrasi kredensial kamera.
CAMERA_ENC_KEY=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# WhatsApp gateway (token internal antara app dan layanan wa-gateway)
WA_GATEWAY_TOKEN=ganti-dengan-token-acak
